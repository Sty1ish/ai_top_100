<mxfile host="app.diagrams.net">
  <diagram id="flow" name="메시지 처리 흐름">
    <mxGraphModel dx="1100" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="사용자가 카카오톡 채널에 메시지 전송" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hook" value="카카오 웹훅 수신&lt;br&gt;비밀 헤더 확인 · 중복 제거&lt;br&gt;1초 안에 204 응답" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="110" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="type" value="이벤트 종류?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="205" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="greet" value="입장 인사 문구" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="640" y="215" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ignore" value="무시 (답장 없음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;" vertex="1" parent="1">
          <mxGeometry x="170" y="215" width="150" height="50" as="geometry" />
        </mxCell>

        <mxCell id="cls" value="&lt;b&gt;결정 모델 Julia-1&lt;/b&gt; 의도 분류 (~0.15초)&lt;br&gt;settle · calc · stock · village · help · other" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#42A5F5;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="conf" value="확률 ≥ 0.6?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="415" y="400" width="130" height="70" as="geometry" />
        </mxCell>
        <mxCell id="which" value="어떤 의도?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="h_settle" value="&lt;b&gt;settle&lt;/b&gt;&lt;br&gt;품목·수량·단가 추출&lt;br&gt;→ settle 도구 → 정산서(ItemCard)&lt;br&gt;숫자 없으면 입력 형식 안내" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h_calc" value="&lt;b&gt;calc&lt;/b&gt;&lt;br&gt;계산식 추출&lt;br&gt;→ calculate 도구 → 결과" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="250" y="610" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h_help" value="&lt;b&gt;help&lt;/b&gt;&lt;br&gt;도움말 + 메뉴 버튼" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="440" y="610" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h_data" value="&lt;b&gt;stock · village&lt;/b&gt;&lt;br&gt;data/faq.json 조회&lt;br&gt;(예선 데이터로 전용 조회 추가 예정)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;" vertex="1" parent="1">
          <mxGeometry x="610" y="610" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="h_ok" value="처리기가&lt;br&gt;답을 만들었나?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="725" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="llm" value="&lt;b&gt;LLM Gemma 4 e2b&lt;/b&gt; (로컬, 느림 10초+)&lt;br&gt;한 번에 하나 · 2~3문장 · 최대 270초" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#FFA726;" vertex="1" parent="1">
          <mxGeometry x="680" y="830" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="llm_ok" value="성공?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="920" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="&quot;잠시 후 다시&quot; 안내" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;" vertex="1" parent="1">
          <mxGeometry x="745" y="1010" width="150" height="45" as="geometry" />
        </mxCell>

        <mxCell id="send" value="말풍선 조립 → 메시지 콜백 API로 답장&lt;br&gt;(콜백 토큰 5분 유효, 1회용)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;" vertex="1" parent="1">
          <mxGeometry x="330" y="1100" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="end" value="사용자가 카카오톡에서 답장 확인" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;" vertex="1" parent="1">
          <mxGeometry x="360" y="1190" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="hook" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="hook" target="type" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
