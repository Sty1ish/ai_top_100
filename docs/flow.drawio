<mxfile host="drawio"><diagram name="flow" id="flow"><mxGraphModel dx="900" dy="1300" grid="1" gridSize="10" guides="1" page="1" pageWidth="880" pageHeight="1320"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;메시지 처리 흐름 (제출본 2026-10-31: 분류 → 분류별 프롬프트 → Claude Haiku → 코드 가드)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="760" height="30" as="geometry"/></mxCell><mxCell id="in" value="카카오 웹훅 수신" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="260" height="44" as="geometry"/></mxCell><mxCell id="chk" value="비밀 헤더 확인 · 중복 제거&lt;br&gt;→ 1초 안에 204 응답" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="260" height="56" as="geometry"/></mxCell><mxCell id="ev" value="이벤트 종류?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="210" width="180" height="80" as="geometry"/></mxCell><mxCell id="greet" value="입장: 인사 안 함 (말풍선 수 감점)&lt;br&gt;(그 밖의 이벤트는 무시)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="620" y="225" width="200" height="50" as="geometry"/></mxCell><mxCell id="sess" value="세션 조회 (user_key별)&lt;br&gt;대화 이력 · TC ID · 누적 분류&lt;br&gt;확인된 주문번호 · 회원" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="260" height="64" as="geometry"/></mxCell><mxCell id="tc" value="TC ID · 문의일이 보이면 추출해 세션에 고정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="260" height="50" as="geometry"/></mxCell><mxCell id="cls" value="① 분류 classify.choose&lt;br&gt;단어 규칙 우선 (토큰 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="486" width="260" height="60" as="geometry"/></mxCell><mxCell id="p" value="규칙에 걸림?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="572" width="180" height="80" as="geometry"/></mxCell><mxCell id="acc" value="누적 분류에 합침" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="260" height="56" as="geometry"/></mxCell><mxCell id="pr" value="② 프롬프트 조립&lt;br&gt;공통 코어&lt;br&gt;+ 누적 분류의 지식 절만&lt;br&gt;+ 누적 분류의 도구만 + load_policy · date_calc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="762" width="260" height="84" as="geometry"/></mxCell><mxCell id="llm" value="③ Claude 도구 호출 루프&lt;br&gt;(프롬프트 캐싱, 최대 6스텝)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="872" width="260" height="60" as="geometry"/></mxCell><mxCell id="tool" value="도구 호출?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="958" width="180" height="80" as="geometry"/></mxCell><mxCell id="api" value="액션 API 호출 (TC 헤더, 결과는 필요한 필드만)&lt;br&gt;&lt;b&gt;코드 가드&lt;/b&gt;: 접수 전 대상 주문 조회 필수 · 같은 조회는 캐시 · 같은 접수·이관 차단&lt;br&gt;환불(29) basis 필수 · 물류 이관 회신 전 환불 차단(하자 제외)&lt;br&gt;이관(35): 하자/변심 판정용 · 현금·재검토 고집 이관 차단(안전·배상·법률 예외)" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="913" width="330" height="170" as="geometry"/></mxCell><mxCell id="pol" value="load_policy(분류)&lt;br&gt;빠진 지식 절을 불러옴" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="968" width="200" height="60" as="geometry"/></mxCell><mxCell id="dl" value="45초 안에&lt;br&gt;끝났나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="1064" width="180" height="80" as="geometry"/></mxCell><mxCell id="fb" value="짧은 안내 문구&lt;br&gt;(확인 후 회신 안내)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="200" height="60" as="geometry"/></mxCell><mxCell id="out" value="답장 후처리: API 이름 제거 · 영어 내부판단 제거 · 미확인 ID 가림(본인 주문 승인번호는 허용)&lt;br&gt;접수 기록 없는 '접수·전달 완료' 문장 제거 · 220자 넘으면 줄여 쓰기 · 300자 절단 · 사과 1회&lt;br&gt;→ SimpleText 1개, 500자 이내, 버튼 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="1170" width="420" height="110" as="geometry"/></mxCell><mxCell id="cb" value="메시지 콜백 API로 전송" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="1320" width="260" height="44" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;분류 (9개)&lt;/b&gt;&lt;br&gt;delivery 배송&lt;br&gt;quality 하자·품질&lt;br&gt;refund 환불&lt;br&gt;payment 결제·증빙&lt;br&gt;promo 쿠폰·할인&lt;br&gt;account 회원·개인정보&lt;br&gt;product 상품&lt;br&gt;event 체험·축제&lt;br&gt;other 기타 (이관·이관 조회)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="200" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;토큰 절약&lt;/b&gt;&lt;br&gt;· 입력 약 5~7천 토큰(대부분 캐시 읽기)&lt;br&gt;· 분류 조합별 캐시 재사용&lt;br&gt;· 이력은 최근 10턴 + 요약&lt;br&gt;· 출력 최대 600토큰, 답은 150자 안팎" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="220" height="150" as="geometry"/></mxCe