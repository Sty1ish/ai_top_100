        <mxCell id="e24" edge="1" parent="1" source="greet" target="send" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#9E9E9E;exitX=1;exitY=0.5;entryX=1;entryY=0.25;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="240" /><mxPoint x="980" y="1115" /></Array></mxGeometry></mxCell>
