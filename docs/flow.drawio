        <mxCell id="e21" value="실패·시간초과" edge="1" parent="1" source="llm_ok" target="fallback" style="endArrow=block;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" value="예 (텍스트 말풍선)" edge="1" parent="1" source="llm_ok" target="send" style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="680" y="950" /><mxPoint x="680" y="1130" /></Array></mxGeometry></mxCell>
