<mxfile host="drawio"><diagram name="flow" id="flow"><mxGraphModel dx="900" dy="1300" grid="1" gridSize="10" guides="1" page="1" pageWidth="880" pageHeight="1320"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;메시지 처리 흐름 (목표 구조: 분류 → 분류별 프롬프트 → Claude)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="760" height="30" as="geometry"/></mxCell><mxCell id="in" value="카카오 웹훅 수신" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="260" height="44" as="geometry"/></mxCell><mxCell id="chk" value="비밀 헤더 확인 · 중복 제거&lt;br&gt;→ 1초 안에 204 응답" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="260" height="56" as="geometry"/></mxCell><mxCell id="ev" value="이벤트 종류?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="210" width="180" height="80" as="geometry"/></mxCell><mxCell id="greet" value="입장: 짧은 인사&lt;br&gt;(그 밖의 이벤트는 무시)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="620" y="225" width="200" height="50" as="geometry"/></mxCell><mxCell id="sess" value="세션 조회 (user_key별)&lt;br&gt;대화 이력 · TC ID · 누적 분류&lt;br&gt;확인된 주문번호 · 회원" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="260" height="64" as="geometry"/></mxCell><mxCell id="tc" value="TC ID가 보이면 추출해 세션에 고정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="410" width="260" height="50" as="geometry"/></mxCell><mxCell id="cls" value="① 분류: 결정 모델 Julia-1&lt;br&gt;(로컬, 약 0.15초, 토큰 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="486" width="260" height="60" as="geometry"/></mxCell><mxCell id="p" value="확률 ≥ 0.6?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="572" width="180" height="80" as="geometry"/></mxCell><mxCell id="acc" value="누적 분류에 합침&lt;br&gt;(1순위, 확률 낮으면 2순위까지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="260" height="56" as="geometry"/></mxCell><mxCell id="pr" value="② 프롬프트 조립&lt;br&gt;공통 코어&lt;br&gt;+ 누적 분류의 지식 절만&lt;br&gt;+ 누적 분류의 도구만 + load_policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="762" width="260" height="84" as="geometry"/></mxCell><mxCell id="llm" value="③ Claude 도구 호출 루프&lt;br&gt;(프롬프트 캐싱, 최대 6스텝)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="872" width="260" height="60" as="geometry"/></mxCell><mxCell id="tool" value="도구 호출?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="958" width="180" height="80" as="geometry"/></mxCell><mxCell id="api" value="액션 API 호출&lt;br&gt;TC 헤더 · 접수 전 조회 확인&lt;br&gt;결과는 필요한 필드만" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="963" width="220" height="70" as="geometry"/></mxCell><mxCell id="pol" value="load_policy(분류)&lt;br&gt;빠진 지식 절을 불러옴" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="968" width="200" height="60" as="geometry"/></mxCell><mxCell id="dl" value="45초 안에&lt;br&gt;끝났나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="1064" width="180" height="80" as="geometry"/></mxCell><mxCell id="fb" value="짧은 안내 문구&lt;br&gt;(확인 후 회신 안내)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="200" height="60" as="geometry"/></mxCell><mxCell id="out" value="답장 조립: SimpleText 1개&lt;br&gt;500자 이내 · 버튼 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="1170" width="260" height="56" as="geometry"/></mxCell><mxCell id="cb" value="메시지 콜백 API로 전송" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="1252" width="260" height="44" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;분류 (8개)&lt;/b&gt;&lt;br&gt;delivery 배송&lt;br&gt;quality 하자·품질&lt;br&gt;refund 환불&lt;br&gt;payment 결제·증빙&lt;br&gt;promo 쿠폰·할인&lt;br&gt;account 회원·개인정보&lt;br&gt;product 상품&lt;br&gt;other 기타 (코어만)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="200" as="geometry"/></mxCell><mxCell id="note2" value="&lt;b&gt;토큰 절약&lt;/b&gt;&lt;br&gt;· 입력 목표 3천 토큰 이하&lt;br&gt;· 분류 조합별 캐시 재사용&lt;br&gt;· 이력은 최근 10턴 + 요약&lt;br&gt;· 출력 최대 300토큰" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="220" height="150" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="in" target="chk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="chk" target="ev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="입장" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev" target="greet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="메시지" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev" target="sess"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="sess" target="tc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="tc" target="cls"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="cls" target="p"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="예: 1순위" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p" target="acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="아니오: 1·2순위" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p" target="acc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="612"/><mxPoint x="600" y="708"/></Array></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="a